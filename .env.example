# Copy to .env for local development. Names only: never commit a value.
DATABASE_URL=
SECRET_KEY=
BASE_URL=
SECURE_COOKIES=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# first boot only; the first login must change it, then clear this
PP_BASE_URL=
PP_SERVICE_TOKEN=
# Separate read-only Relaunch72 founder CRM token; same value as R72_GROUP_HQ_CRM_TOKEN on the PP service.
R72_CRM_TOKEN=
ORDRIS_BASE_URL=
ORDRIS_PARTNER_TOKEN=
KP_BASE_URL=
KP_PARTNER_TOKEN=
HNH_BASE_URL=
HNH_PARTNER_TOKEN=
CONNECTORS_DRY_RUN=
# 1, 0, or a list of products to keep in dry run, for example ordris,kp,hnh. The list is the default for a product
# whose switch on the Settings screen has never been set; 1 holds every product in dry run whatever the switches say.
# Franchise follow-up emails (app.services.followups). Leave SMTP_HOST empty and the emails are shown for
# copying on the opportunity page and nothing is sent. STARTTLS defaults to on; port defaults to 587.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=
MAIL_FROM=
# Bearer token Hello New Home presents to GET /api/territories.json (district, area, state only). Empty
# means admin session only.
TERRITORY_EXPORT_TOKEN=
# Growth (docs/growth.md): read-only credentials, every one empty until used. Every source starts Off on Growth > Sources.
GOOGLE_SA_JSON=
# the service-account key file's JSON on one line; Viewer in GA4, Restricted user in Search Console
GA4_PROPERTY_IDS=
# pp=123456789,kp=...
GSC_SITES=
# pp=sc-domain:propertypredator.com,...
STRIPE_RK_MH196=
STRIPE_RK_HNH=
# restricted keys, Read on the resources docs/growth.md lists, None on everything else
STRIPE_PRODUCT_MAP=
# prod_...=pp,price_...=ordris (subscription metadata.product wins)
BREVO_API_KEY_HQ=
BREVO_LIST_PRODUCTS=
# 123=kp,456=pp
ZERNIO_API_KEY=
ZERNIO_PROFILE_PRODUCTS=
ZERNIO_AD_ACCOUNTS=
# <profileId>=pp,... and, once connected in Zernio, <accountId>=tiktok,<accountId>=x
NEON_API_KEY=
NEON_ORG_ID=
NEON_PROJECT_PRODUCTS=
# An organisation key, which can change and delete projects: web service and the daily growth cron only, never logged.
# projectId=pp,projectId=grouphq,... (labels are free text; an unlabelled project shows its Neon name)
CLERK_SECRET_KEY_ORDRIS=
# not recommended and not in render.yaml: Clerk's backend key can delete Ordris users (docs/growth.md)
